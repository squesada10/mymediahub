datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum MediaType {
  movie
  show
}

enum MediaStatus {
  to_watch @map("to-watch")
  watching
  watched
}

model MediaItem {
  id         String   @id @default(cuid())
  tmdbId     Int?
  title      String
  type       MediaType   // "movie" | "tv"
  status     MediaStatus   // "to-watch" | "watching" | "watched"
  overview   String?
  posterUrl  String?
  genresJson String  @map("genres")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

